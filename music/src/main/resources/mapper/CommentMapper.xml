<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.music.mapper.CommentMapper">

    <!-- 实体映射 -->
    <resultMap id="CommentResultMap" type="com.example.music.entity.Comment">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="musicId" column="music_id"/>
        <result property="parentId" column="parent_id"/>
        <result property="comment" column="comment"/>
        <result property="publishTime" column="publish_time"/>
    </resultMap>

    <!-- 根据音乐ID查询评论 -->
    <select id="queryByMusicId" resultMap="CommentResultMap">
        SELECT *
        FROM comment
        WHERE music_id = #{musicId}
        ORDER BY publish_time DESC
    </select>

    <!-- 根据ID查询评论 -->
    <select id="queryById" resultMap="CommentResultMap">
        SELECT *
        FROM comment
        WHERE id = #{id}
    </select>

    <!-- 根据父评论ID列表查询回复 -->
    <select id="queryByParentId" resultMap="CommentResultMap">
        SELECT *
        FROM comment
        WHERE parent_id = #{parentId}
        ORDER BY publish_time ASC
    </select>

    <!-- 添加评论 -->
    <insert id="add" parameterType="com.example.music.entity.Comment"
            useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO comment
        (user_id,
        music_id,
        parent_id,
        comment,
        publish_time)
        VALUES
        (#{userId},
        #{musicId},
        #{parentId},
        #{comment},
        now())
    </insert>

    <!-- 修改评论 -->
    <update id="modify" parameterType="com.example.music.entity.Comment">
        UPDATE comment
        SET comment = #{comment}
        WHERE id = #{id}
    </update>

    <!-- 删除评论 -->
    <delete id="delete">
        DELETE
        FROM comment
        WHERE id = #{id}
    </delete>
    <delete id="deleteByMusicId">
        DELETE
        FROM comment
        WHERE music_id = #{musicId}
    </delete>

</mapper>